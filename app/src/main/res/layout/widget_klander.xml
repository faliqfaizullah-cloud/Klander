<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="14dp">
    <TextView android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#E5352B" android:textSize="12sp" android:textStyle="bold"/>
    <TextView android:id="@+id/num" android:layout_below="@id/day" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#111111" android:textSize="40sp" android:textStyle="bold" android:includeFontPadding="false"/>
    <TextView android:id="@+id/sticker" android:layout_alignParentEnd="true" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="30sp"/>
    <TextView android:id="@+id/ev" android:layout_alignParentBottom="true" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFEB00" android:padding="6dp" android:maxLines="2" android:ellipsize="end"
        android:textColor="#111111" android:textSize="11sp" android:textStyle="bold"/>
</RelativeLayout>
